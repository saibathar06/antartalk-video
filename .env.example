# Production is the default. Set development ONLY for local HTTP / no TURN tests.
NODE_ENV=production
PORT=8080
BIND_HOST=0.0.0.0
PUBLIC_ORIGIN=https://video.example.com
APP_ORIGINS=https://app.example.com
# Generate with: openssl rand -hex 32. Only the trusted booking/backend knows it.
SERVICE_API_KEY=
# Reuse the managed PostgreSQL server; the service owns only the antartalk_video schema.
DATABASE_URL=postgresql://user:password@host:5432/database
# Development/test fallback only when NODE_ENV=development and DATABASE_URL is omitted.
DATABASE_PATH=./data/calls.sqlite
# Coturn REST credentials. Match static-auth-secret in coturn.conf.
TURN_SECRET=
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Relay mode hides participant IP addresses from each other; budgets must include TURN bandwidth.
RELAY_ONLY=true
